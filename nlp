# Practical 5: Finding Synonyms and Antonyms using WordNet
from nltk.corpus import wordnet

nltk.download('wordnet')

word = input("Enter a word: ")
synonyms = set()
antonyms = set()

for syn in wordnet.synsets(word):
    for lemma in syn.lemmas():
        synonyms.add(lemma.name())
        for antonym in lemma.antonyms():
            antonyms.add(antonym.name())

print("\nWord:", word)

print("\nSynonyms:")
if synonyms:
    for synonym in sorted(synonyms):
        print(synonym)
else:
    print("No synonyms found.")

print("\nAntonyms:")
if antonyms:
    for antonym in sorted(antonyms):
        print(antonym)
else:
    print("No antonyms found.")


# Practical 6: Lemmatization with NLTK and POS Tagging
from nltk.stem import WordNetLemmatizer

lemmatizer = WordNetLemmatizer()

words = ["playing", "played", "plays", "studies",
         "studying", "better", "dogs", "children"]

print("Word\t\tLemma")
print("-------------------------")

for word in words:
    lemma = lemmatizer.lemmatize(word)
    print(word, "\t\t", lemma)

print("\nLemmatization with POS:")
print("playing ->", lemmatizer.lemmatize("playing", pos="v"))
print("studies  ->", lemmatizer.lemmatize("studies", pos="v"))
print("better   ->", lemmatizer.lemmatize("better", pos="a"))
print("children ->", lemmatizer.lemmatize("children", pos="n"))


# Practical 7: Sentiment Analysis using TextBlob
from textblob import TextBlob

tweets = [
    "I love this new phone. It is amazing!",
    "This movie was excellent and I really enjoyed it.",
    "The service was very slow and disappointing.",
    "I hate this product. It is terrible.",
    "The weather is okay today.",
    "Python is a great programming language!"
]

print("Twitter Sentiment Analysis")
print("==========================")

for tweet in tweets:
    analysis = TextBlob(tweet)
    polarity = analysis.sentiment.polarity

    if polarity > 0:
        sentiment = "Positive"
    elif polarity < 0:
        sentiment = "Negative"
    else:
        sentiment = "Neutral"

    print("\nTweet:", tweet)
    print("Polarity:", polarity)
    print("Sentiment:", sentiment)





